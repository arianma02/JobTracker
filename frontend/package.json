{
  "name": "jobtrack-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json .prettierrc.json"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "4.1.12"
  }
}
